# 이 파일을 .env.local 로 복사하고 값을 채우세요. 그다음 dev 서버 재시작.

# ── AI 카피 생성 (무료) — https://aistudio.google.com/apikey ──
GEMINI_API_KEY=

# ── Supabase — 프로젝트 Settings > API ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 결제 (LemonSqueezy) ──
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_LIFETIME=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── 요금제 페이지 표기 금액 (LemonSqueezy 상품 가격과 일치시킬 것) ──
NEXT_PUBLIC_PRICE_PRO=9,900원
NEXT_PUBLIC_PRICE_LIFETIME=89,000원
